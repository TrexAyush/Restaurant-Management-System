{
  "name": "restaurant-management-system",
  "version": "1.0.0",
  "description": "A comprehensive restaurant management system with order management, table management, billing, and inventory tracking",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "seed:all": "knex seed:run --specific=000_run_all_seeds.ts",
    "seed:reset": "npm run migrate:rollback -- --all && npm run migrate && npm run seed:all",
    "db:setup": "npm run migrate && npm run seed:all"
  },
  "keywords": [
    "restaurant",
    "management",
    "pos",
    "inventory",
    "orders"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.0.1",
    "morgan": "^1.10.0",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.5",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.6",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/morgan": "^1.9.7",
    "@types/node": "^20.8.7",
    "@types/pdfkit": "^0.12.12",
    "@types/pg": "^8.10.7",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.8",
    "concurrently": "^8.2.2",
    "fast-check": "^3.13.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
