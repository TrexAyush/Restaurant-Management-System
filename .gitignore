# Dependencies
backend/node_modules/
frontend/node_modules/
backend/.pnp
backend/.pnp.js
frontend/.pnp
frontend/.pnp.js

# Production builds
backend/dist/
backend/build/
frontend/dist/
frontend/build/

# Environment variables
backend/.env
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*
backend/lerna-debug.log*
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/lerna-debug.log*

# Runtime data
backend/pids
backend/*.pid
backend/*.seed
backend/*.pid.lock
frontend/pids
frontend/*.pid
frontend/*.seed
frontend/*.pid.lock

# Coverage directory used by tools like istanbul
backend/coverage/
backend/*.lcov
frontend/coverage/
frontend/*.lcov

# nyc test coverage
backend/.nyc_output
frontend/.nyc_output

# Dependency directories
backend/jspm_packages/
frontend/jspm_packages/

# TypeScript cache
backend/*.tsbuildinfo
frontend/*.tsbuildinfo

# Optional npm cache directory
backend/.npm
frontend/.npm

backend/package-lock.json
frontend/package-lock.json

# Optional eslint cache
backend/.eslintcache
frontend/.eslintcache

# Microbundle cache
backend/.rpt2_cache/
backend/.rts2_cache_cjs/
backend/.rts2_cache_es/
backend/.rts2_cache_umd/
frontend/.rpt2_cache/
frontend/.rts2_cache_cjs/
frontend/.rts2_cache_es/
frontend/.rts2_cache_umd/

# Optional REPL history
backend/.node_repl_history
frontend/.node_repl_history

# Output of 'npm pack'
backend/*.tgz
frontend/*.tgz

# Yarn Integrity file
backend/.yarn-integrity
frontend/.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
backend/.cache
backend/.parcel-cache
frontend/.cache
frontend/.parcel-cache

# Next.js build output
backend/.next
frontend/.next

# Nuxt.js build / generate output
backend/.nuxt
frontend/.nuxt

# Gatsby files
backend/.cache/
backend/public
frontend/.cache/
frontend/public

# Storybook build outputs
backend/.out
backend/.storybook-out
frontend/.out
frontend/.storybook-out

# Temporary folders
backend/tmp/
backend/temp/
frontend/tmp/
frontend/temp/

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

